# Load with: node --env-file=.env server.mjs
APP_URL=http://localhost:3000
PORT=3000
DATA_DIR=./data
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable and back it up separately from the encrypted database.
DATA_KEY=
ALLOWED_EMAIL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Microsoft personal-account sign-in and Hotmail/Outlook bill scanning.
# See docs/microsoft.md. Never commit real client secrets.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Set only after registering this exact HTTPS URL in Plaid's dashboard.
# PLAID_REDIRECT_URI=https://your-host/plaid-return
